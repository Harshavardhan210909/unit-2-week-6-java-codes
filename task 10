import java.io.*;
import java.util.*;

public class Solution {

    static int[] radius;
    static int[][] sparse;
    static int[] log;

    // --------------------------------------------------
    // Manacher's Algorithm
    // --------------------------------------------------

    static void manacher(String s) {

        int n = s.length();

        // Transformed string length = 2 * n + 1
        int m = 2 * n + 1;

        radius = new int[m];

        int center = 0;
        int right = 0;

        for (int i = 0; i < m; i++) {

            int mirror = 2 * center - i;

            if (i < right) {
                radius[i] =
                    Math.min(right - i, radius[mirror]);
            }

            while (i - radius[i] - 1 >= 0 &&
                   i + radius[i] + 1 < m &&
                   getChar(s, i - radius[i] - 1)
                   ==
                   getChar(s, i + radius[i] + 1)) {

                radius[i]++;
            }

            if (i + radius[i] > right) {
                center = i;
                right = i + radius[i];
            }
        }
    }

    // Get character from transformed string
    static char getChar(String s, int index) {

        // Even positions are '#'
        if (index % 2 == 0) {
            return '#';
        }

        // Odd positions contain original characters
        return s.charAt(index / 2);
    }

    // --------------------------------------------------
    // Sparse Table for Range Maximum Query
    // --------------------------------------------------

    static void buildSparseTable() {

        int n = radius.length;

        log = new int[n + 1];

        for (int i = 2; i <= n; i++) {
            log[i] = log[i / 2] + 1;
        }

        int levels = log[n] + 1;

        sparse = new int[levels][n];

        // Level 0
        for (int i = 0; i < n; i++) {
            sparse[0][i] = radius[i];
        }

        // Other levels
        for (int k = 1; k < levels; k++) {

            int length = 1 << k;
            int half = length >> 1;

            for (int i = 0;
                 i + length <= n;
                 i++) {

                sparse[k][i] =
                    Math.max(
                        sparse[k - 1][i],
                        sparse[k - 1][i + half]
                    );
            }
        }
    }

    // --------------------------------------------------
    // Range Maximum Query
    // --------------------------------------------------

    static int rangeMax(int left, int right) {

        if (left > right) {
            return 0;
        }

        int length = right - left + 1;

        int k = log[length];

        return Math.max(
            sparse[k][left],
            sparse[k][right - (1 << k) + 1]
        );
    }

    // --------------------------------------------------
    // Find answer for one rotation
    // --------------------------------------------------

    static int longestForRotation(int start, int n) {

        int low = 1;
        int high = n;
        int answer = 1;

        while (low <= high) {

            int len = (low + high) / 2;

            /*
             * Convert the possible palindrome center
             * range into transformed-string coordinates.
             */
            int left = 2 * start + len - 1;

            int right =
                2 * (start + n - 1) - len + 1;

            if (left <= right &&
                rangeMax(left, right) >= len) {

                answer = len;
                low = len + 1;

            } else {

                high = len - 1;
            }
        }

        return answer;
    }

    // --------------------------------------------------
    // Main
    // --------------------------------------------------

    public static void main(String[] args)
        throws Exception {

        BufferedReader br =
            new BufferedReader(
                new InputStreamReader(System.in)
            );

        int n =
            Integer.parseInt(
                br.readLine().trim()
            );

        String s = br.readLine().trim();

        // Duplicate string to handle circular rotations
        String doubled = s + s;

        // Run Manacher
        manacher(doubled);

        // Build RMQ
        buildSparseTable();

        StringBuilder output =
            new StringBuilder();

        // Calculate answer for every rotation
        for (int rotation = 0;
             rotation < n;
             rotation++) {

            int answer =
                longestForRotation(rotation, n);

            output.append(answer).append('\n');
        }

        System.out.print(output);
    }
}
