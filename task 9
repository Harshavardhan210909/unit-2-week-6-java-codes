class Solution {

    public String longestPalindrome(String s) {

        if (s == null || s.length() < 2) {
            return s;
        }

        // Transform the string
        // Example: "babad" -> "^#b#a#b#a#d#$"
        StringBuilder t = new StringBuilder();

        t.append("^");

        for (char c : s.toCharArray()) {
            t.append("#");
            t.append(c);
        }

        t.append("#$");

        int n = t.length();

        // p[i] = radius of palindrome centered at i
        int[] p = new int[n];

        int center = 0;
        int right = 0;

        int maxLength = 0;
        int maxCenter = 0;

        for (int i = 1; i < n - 1; i++) {

            // Mirror position of i
            int mirror = 2 * center - i;

            if (i < right) {
                p[i] = Math.min(right - i, p[mirror]);
            }

            // Expand around center i
            while (t.charAt(i + 1 + p[i]) ==
                   t.charAt(i - 1 - p[i])) {

                p[i]++;
            }

            // Update center and right boundary
            if (i + p[i] > right) {
                center = i;
                right = i + p[i];
            }

            // Update longest palindrome
            if (p[i] > maxLength) {
                maxLength = p[i];
                maxCenter = i;
            }
        }

        // Convert transformed index back to original string index
        int start = (maxCenter - maxLength) / 2;

        return s.substring(start, start + maxLength);
    }
}
